<footer class="site-footer">
  <div class="footer-charge" aria-hidden="true">
    <span class="battery"><span class="battery-fill"></span></span>
    <span class="charge-track"><span class="charge-fill"></span></span>
  </div>
  <div class="road-line" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <nav aria-label="Coverage">
      <h2>{% set iconName = "cars" %}{% include "partials/section-icon.njk" %} Coverage</h2>
      <ul>
        {% for item in site.categories %}
        <li><a href="{{ ('/topics/' ~ item.slug ~ '/') | url }}">{{ item.name }}</a></li>
        {% endfor %}
        <li><a href="{{ '/dashboard/' | url }}">Dashboard</a></li>
        <li><a href="{{ '/data/' | url }}">EV data</a></li>
        <li><a href="{{ '/archive/' | url }}">Archive</a></li>
      </ul>
    </nav>
    <nav aria-label="Company links">
      <h2>{% set iconName = "company" %}{% include "partials/section-icon.njk" %} Company</h2>
      <ul>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact Us</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal and feeds">
      <h2>{% set iconName = "legal" %}{% include "partials/section-icon.njk" %} Legal and feeds</h2>
      <ul>
        <li><a href="{{ '/sources-ethics/' | url }}">Sources &amp; Ethics</a></li>
        <li><a href="{{ '/corrections/' | url }}">Corrections</a></li>
        <li><a href="{{ '/terms/' | url }}">Terms</a></li>
        <li><a href="{{ '/privacy/' | url }}">Privacy</a></li>
        <li><a href="{{ '/disclaimer/' | url }}">Disclaimer</a></li>
        <li><a href="{{ '/feed.xml' | url }}">RSS</a></li>
        <li><a href="{{ '/atom.xml' | url }}">Atom</a></li>
      </ul>
    </nav>
  </div>
</footer>
