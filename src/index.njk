---
layout: layouts/base.njk
kind: home
permalink: /
---
<header class="masthead">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{% include "partials/bolt.njk" %} Sourced electric-vehicle reporting</p>
      <h1>{{ site.name }}</h1>
      <p class="tagline">{{ site.tagline }}</p>
      <p class="brand-line">{{ site.brandLine }}</p>
    </div>
    <div class="hero-panel">
      <p class="panel-kicker">Daily charge</p>
      {% set srcBase = "hero" %}
      {% set imageAlt = "Original illustration of an electric car, a charge bolt, and a battery" %}
      {% set imageWidth = 1200 %}
      {% set imageHeight = 675 %}
      {% set imageLoading = "eager" %}
      {% set imagePriority = "high" %}
      {% include "partials/picture.njk" %}
      <div class="charge-track" aria-hidden="true"><span class="charge-fill"></span></div>
      <p class="panel-note">Five desks, one sourced story a day.</p>
      <p class="hero-credit">Original illustration · EV News Desk</p>
    </div>
  </div>
  {% include "partials/hero-scene.njk" %}
</header>
{% include "partials/energy-divider.njk" %}
<div class="wrap">
  <div class="home-grid">
    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="section-heading">{% set iconName = "bolt" %}{% include "partials/section-icon.njk" %} Latest</h2>
      {% set stories = collections.posts | limit(20) %}
      {% set storyHeading = "h3" %}
      {% set emptyNote = "No story has been published yet. The desk files one sourced article a day. A story appears here after it leaves draft status with a public source list." %}
      {% include "partials/story-list.njk" %}
      {% if collections.posts.length > 20 %}
      <p><a href="{{ '/archive/' | url }}">All stories</a></p>
      {% endif %}
    </section>
    <aside class="home-rail">
      <section aria-labelledby="desks-heading">
      <h2 id="desks-heading">{% set iconName = "batteries" %}{% include "partials/section-icon.njk" %} Desks</h2>
      <div class="desk-list">
        {% for item in site.categories %}
        <a class="desk-card" href="{{ ('/category/' ~ item.slug ~ '/') | url }}">
          <span class="desk-card-top">{% set iconName = item.slug %}{% include "partials/section-icon.njk" %}<strong>{{ item.name }}</strong></span>
          <span>{{ item.description }}</span>
          <span class="mini-charge" aria-hidden="true"><span class="mini-charge-fill"></span></span>
        </a>
        {% endfor %}
      </div>
      </section>
      {% include "partials/energy-divider.njk" %}
      <section aria-labelledby="publishing-heading">
      <h2 id="publishing-heading">{% set iconName = "policy" %}{% include "partials/section-icon.njk" %} How a story gets published</h2>
      <ol class="process">
        <li>Write it in Markdown under the content folder.</li>
        <li>Link each claim to a public source in the sentence it supports.</li>
        <li>Add a sources list with title, URL, publisher, and date.</li>
        <li>Remove draft status. The build stops if that list is missing.</li>
      </ol>
      </section>
    </aside>
  </div>
</div>
