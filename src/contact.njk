---
layout: layouts/page.njk
title: Contact Us
summary: Send a message to EV News Desk. No street address is published.
permalink: /contact/
formAction: "https://formsubmit.co"
---
<p>Send a message to {{ site.name }}. {{ site.name }} is owned and operated by {{ site.operator }}, {{ site.entityDescription }}. We do not publish a street address.</p>
<form id="contact-form" class="contact-form" action="{{ site.contactFormEndpoint }}" method="post" accept-charset="UTF-8">
  <input type="hidden" name="_subject" value="EV News Desk message">
  <input type="hidden" name="_captcha" value="false">
  <input type="hidden" name="_template" value="table">
  <input type="hidden" name="_next" value="{{ '/contact/thanks/' | absoluteUrl }}">
  <input type="hidden" name="_ready" id="contact-ready" value="">
  <p class="contact-honey" aria-hidden="true">
    <label for="contact-honey">Leave this field empty</label>
    <input id="contact-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" value="">
  </p>
  <p>
    <label for="contact-name">Name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="200">
  </p>
  <p>
    <label for="contact-email">Email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200">
  </p>
  <p>
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" required maxlength="5000" rows="8"></textarea>
  </p>
  <p id="contact-status" class="form-status" role="status"></p>
  <button type="submit">Send message</button>
</form>
<p>Messages are emailed to the site owner only to respond and are not sold. Read the <a href="{{ '/privacy/' | url }}">privacy policy</a>.</p>
<script>
(function () {
  var form = document.getElementById("contact-form");
  var ready = document.getElementById("contact-ready");
  var status = document.getElementById("contact-status");
  if (!form || !ready) return;
  var opened = Date.now();
  var waitMs = 3000;
  window.setTimeout(function () { ready.value = "1"; }, waitMs);
  form.addEventListener("submit", function (event) {
    var honey = form.querySelector("[name='_honey']");
    if (honey && honey.value) {
      event.preventDefault();
      return;
    }
    if (Date.now() - opened < waitMs) {
      event.preventDefault();
      if (status) status.textContent = "Please wait a few seconds, then send the message again.";
      return;
    }
    if (status) status.textContent = "";
  });
})();
</script>
<h2>What to send</h2>
<ul>
  <li>Corrections: the article URL, the passage, and a link to a public source. The policy is on the <a href="{{ '/corrections/' | url }}">corrections page</a>.</li>
  <li>Tips: documents or pages a reader can open, not a claim with nowhere to check it.</li>
  <li>Replies go to the email address you entered. There is no account and no mailing list on this site.</li>
</ul>
